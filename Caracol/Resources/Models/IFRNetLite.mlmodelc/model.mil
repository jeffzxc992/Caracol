program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios19>(tensor<fp32, [1, 3, 144, 256]> cur, tensor<fp32, [1, 2, 144, 256]> flow, tensor<fp32, [1, 3, 144, 256]> prev) {
            string flow_to_fp16_dtype_0 = const()[name = string("flow_to_fp16_dtype_0"), val = string("fp16")];
            string flow_out_cast_fp16_to_fp32_dtype_0 = const()[name = string("flow_out_cast_fp16_to_fp32_dtype_0"), val = string("fp32")];
            tensor<fp16, [1, 2, 144, 256]> flow_to_fp16 = cast(dtype = flow_to_fp16_dtype_0, x = flow)[name = string("cast_1")];
            tensor<fp32, [1, 2, 144, 256]> flow_out = cast(dtype = flow_out_cast_fp16_to_fp32_dtype_0, x = flow_to_fp16)[name = string("cast_0")];
            tensor<fp32, [1, 3, 144, 256]> prev_tmp = identity(x = prev)[name = string("prev_tmp")];
            tensor<fp32, [1, 3, 144, 256]> cur_tmp = identity(x = cur)[name = string("cur_tmp")];
        } -> (flow_out);
}